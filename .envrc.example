# direnv environment for pawl.
#
# Everything set here is scoped to this directory and disappears when you cd out,
# which is the point: `pawl` should mean this build while you are working on it
# and mean nothing once you leave.

if has go; then
  # `go install ./cmd/pawl` lands the binary in ./bin, and PATH_add puts that on
  # PATH for this directory only. Avoids the usual ~/go/bin-not-on-PATH dance
  # and avoids a dev build shadowing a real pawl install elsewhere on the box.
  export GOBIN="$(expand_path ./bin)"
  PATH_add bin

  # pawl ships as a static binary with no runtime dependency. Setting this here
  # makes that true by construction rather than by luck — cgo would link the
  # host libc and quietly break the property the whole distribution rests on.
  export CGO_ENABLED=0

  if [[ ! -x ./bin/pawl ]]; then
    log_status "no binary yet — build it with: go install ./cmd/pawl  (or: make build)"
  fi
else
  log_error "go not found on PATH; pawl needs a Go toolchain to build"
fi
