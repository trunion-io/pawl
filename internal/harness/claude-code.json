{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "pawl hook claude-code --event stop",
          "timeout": 10,
          "statusMessage": "pawl: checking accounting"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "pawl hook claude-code",
          "timeout": 10,
          "statusMessage": "pawl: checking accounting"
        }
      ]
    }
  ]
}
